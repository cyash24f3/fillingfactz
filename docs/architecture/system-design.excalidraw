    {
      "id": "arch-0232",
      "type": "text",
      "x": 6385,
      "y": 3026,
      "width": 744.6116943359375,
      "height": 110,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "arch-0230-group"
      ],
      "frameId": "frame-06",
      "index": "b2j",
      "roundness": null,
      "seed": 814393314,
      "version": 2,
      "versionNonce": 1111338082,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793901027881,
      "link": null,
      "locked": false,
      "text": "An asyncio.Lock serializes runs inside one API process.\nSeparate CLI processes are independent; there is no global scheduler.\nClient timeout: connect 5s / stream read 180s; Ollama request 120s.\nUnknown token counts stay null; incomplete status remains explicit.",
      "fontSize": 22,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "An asyncio.Lock serializes runs inside one API process.\nSeparate CLI processes are independent; there is no global scheduler.\nClient timeout: connect 5s / stream read 180s; Ollama request 120s.\nUnknown token counts stay null; incomplete status remains explicit.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "arch-0233",
      "type": "text",
      "x": 5190,
      "y": 3210,
      "width": 1374.3653564453125,
      "height": 26.25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
