      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Example: a stale “latest cash” statement",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "arch-0250",
      "type": "text",
      "x": 1265,
      "y": 4716,
      "width": 727.4517211914062,
      "height": 165,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "arch-0248-group"
      ],
      "frameId": "frame-07",
      "index": "b31",
      "roundness": null,
      "seed": 1887443362,
      "version": 2,
      "versionNonce": 1765936674,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793901027881,
      "link": null,
      "locked": false,
      "text": "1. Plan metric = cash; scope = latest within supplied filings.\n2. Recall + fresh search; read July and October balance sheets.\n3. July PDF page 6: 4,038,536; October PDF page 9: 4,260,324.\n4. Both tables are in thousands → USD 4.038536B / 4.260324B.\n5. Model proposes OUTDATED; gate authenticates both citations.\n6. Return report to reviewer; retain accepted source evidence.",
      "fontSize": 22,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Plan metric = cash; scope = latest within supplied filings.\n2. Recall + fresh search; read July and October balance sheets.\n3. July PDF page 6: 4,038,536; October PDF page 9: 4,260,324.\n4. Both tables are in thousands → USD 4.038536B / 4.260324B.\n5. Model proposes OUTDATED; gate authenticates both citations.\n6. Return report to reviewer; retain accepted source evidence.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
