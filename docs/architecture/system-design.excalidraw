      "link": null,
      "locked": false,
      "text": "Parsed-PDF cache: avoid extracting unchanged documents again.\nCorpus index: fast search over canonical page passages.\nEvidence memory: reuse authenticated sources across claims.\nNo answer cache. Memory reads/writes are measured separately\nfrom LLM/tool calls; a hit alone is not a demonstrated saving.",
      "fontSize": 22,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Parsed-PDF cache: avoid extracting unchanged documents again.\nCorpus index: fast search over canonical page passages.\nEvidence memory: reuse authenticated sources across claims.\nNo answer cache. Memory reads/writes are measured separately\nfrom LLM/tool calls; a hit alone is not a demonstrated saving.",
      "autoResize": true,
      "lineHeight": 1.25
    },
