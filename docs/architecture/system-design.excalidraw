      "isDeleted": false,
      "boundElements": null,
      "updated": 1793901027881,
      "link": null,
      "locked": false,
      "text": "Only a complete result with evidence\ncan write to the memory namespace.\nRecheck source and quote before writing.\nMemory failures are traced; verification\ncontinues with fresh corpus evidence.",
      "fontSize": 22,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Only a complete result with evidence\ncan write to the memory namespace.\nRecheck source and quote before writing.\nMemory failures are traced; verification\ncontinues with fresh corpus evidence.",
      "autoResize": true,
      "lineHeight": 1.25
    },
