    {
      "id": "arch-0304",
      "type": "text",
      "x": 3825,
      "y": 4786,
      "width": 679.20556640625,
      "height": 137.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "arch-0302-group"
      ],
      "frameId": "frame-08",
      "index": "b3t",
      "roundness": null,
      "seed": 453025506,
      "version": 2,
      "versionNonce": 1008427874,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793901027881,
      "link": null,
      "locked": false,
      "text": "92 automated tests; 12 / 12 additional live API cases.\nClean installation and GitHub CI passed. Swagger + UI verified.\nFresh namespaces; no answer cache or case-ID routing.\nPreserve the original baseline alongside the final predictions.\nDevelopment benchmark, not held-out generalization evidence.",
      "fontSize": 22,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "92 automated tests; 12 / 12 additional live API cases.\nClean installation and GitHub CI passed. Swagger + UI verified.\nFresh namespaces; no answer cache or case-ID routing.\nPreserve the original baseline alongside the final predictions.\nDevelopment benchmark, not held-out generalization evidence.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "arch-0305",
      "type": "text",
      "x": 2630,
      "y": 4970,
      "width": 1782.52099609375,
      "height": 26.25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "frame-08",
      "index": "b3u",
      "roundness": null,
      "seed": 168212542,
      "version": 2,
      "versionNonce": 810056638,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793901027881,
      "link": null,
      "locked": false,
      "text": "Reproduce: python -m filing_checker.evaluate --mode all --max-model-calls 8 --max-tool-calls 16. Results: results/benchmark/; protocol and comparisons: docs/EVALUATION.md.",
      "fontSize": 21,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Reproduce: python -m filing_checker.evaluate --mode all --max-model-calls 8 --max-tool-calls 16. Results: results/benchmark/; protocol and comparisons: docs/EVALUATION.md.",
      "autoResize": true,
      "lineHeight": 1.25
    },
