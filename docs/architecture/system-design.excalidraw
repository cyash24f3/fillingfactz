      "seed": 1967080994,
      "version": 2,
      "versionNonce": 885480098,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793901027881,
      "link": null,
      "locked": false,
      "text": "runtime/evidence_memory.sqlite | namespaced FTS5\nStored: namespace, passage_id, filing_id, source_key, quote, text.\nsource_key hashes canonical passage text and metadata,\nincluding the original PDF fingerprint.\nStore authenticated source material, not model verdicts.\nNamespaces separate reviewer collections and benchmark modes.\nOld or changed source records become recall misses.",
      "fontSize": 24,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "runtime/evidence_memory.sqlite | namespaced FTS5\nStored: namespace, passage_id, filing_id, source_key, quote, text.\nsource_key hashes canonical passage text and metadata,\nincluding the original PDF fingerprint.\nStore authenticated source material, not model verdicts.\nNamespaces separate reviewer collections and benchmark modes.\nOld or changed source records become recall misses.",
      "autoResize": true,
      "lineHeight": 1.25
    },
