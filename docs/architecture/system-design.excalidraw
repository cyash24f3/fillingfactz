      "versionNonce": 1413404862,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793901027881,
      "link": null,
      "locked": false,
      "text": "Remove generic date / number / unit terms.\nPorter stemming + BM25 keyword candidates.\nRequire up to 3 topical terms to match.\nRecheck fingerprint and saved quote.\nReturn at most 3 unique canonical passages.",
      "fontSize": 22,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Remove generic date / number / unit terms.\nPorter stemming + BM25 keyword candidates.\nRequire up to 3 topical terms to match.\nRecheck fingerprint and saved quote.\nReturn at most 3 unique canonical passages.",
      "autoResize": true,
      "lineHeight": 1.25
    },
