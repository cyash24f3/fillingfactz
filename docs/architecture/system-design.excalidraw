      "isDeleted": false,
      "boundElements": null,
      "updated": 1793901027881,
      "link": null,
      "locked": false,
      "text": "Decimal arithmetic: thousands / millions / billions and rounding.\nBind comparative numeric columns to explicit year / date headings.\nA rounded disclosure cannot refute overlapping finer precision.\nInterim figures do not establish later full-year actuals.\nGlobal headcount alone cannot disprove a smaller regional count.",
      "fontSize": 22,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Decimal arithmetic: thousands / millions / billions and rounding.\nBind comparative numeric columns to explicit year / date headings.\nA rounded disclosure cannot refute overlapping finer precision.\nInterim figures do not establish later full-year actuals.\nGlobal headcount alone cannot disprove a smaller regional count.",
      "autoResize": true,
      "lineHeight": 1.25
    },
