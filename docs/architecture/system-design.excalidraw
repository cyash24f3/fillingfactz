      "frameId": "frame-04",
      "index": "b1M",
      "roundness": null,
      "seed": 2119675006,
      "version": 2,
      "versionNonce": 717750270,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793901027881,
      "link": null,
      "locked": false,
      "text": "Outer state: statement, start time, planning, recalled passages,\nmemory statistics / events, final result.\nExecutor state: messages[], pending_calls[], searched_filings[],\nread_passage_ids[], initial_passages[], trace[], call/token counters,\nformat reminders, stagnant_searches, result.\nTool results and validation feedback append to messages.\nThere is no durable LangGraph checkpoint or resume feature.",
      "fontSize": 24,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Outer state: statement, start time, planning, recalled passages,\nmemory statistics / events, final result.\nExecutor state: messages[], pending_calls[], searched_filings[],\nread_passage_ids[], initial_passages[], trace[], call/token counters,\nformat reminders, stagnant_searches, result.\nTool results and validation feedback append to messages.\nThere is no durable LangGraph checkpoint or resume feature.",
      "autoResize": true,
      "lineHeight": 1.25
    },
