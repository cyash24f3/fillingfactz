      "isDeleted": false,
      "boundElements": null,
      "updated": 1793901027881,
      "link": null,
      "locked": false,
      "text": "The example is T15 in results/benchmark/full/predictions.json. The same July value is SUPPORTED when explicitly described as the 31 July 2024 historical balance.",
      "fontSize": 21,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The example is T15 in results/benchmark/full/predictions.json. The same July value is SUPPORTED when explicitly described as the 31 July 2024 historical balance.",
