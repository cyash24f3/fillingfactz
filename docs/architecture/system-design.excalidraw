      "boundElements": null,
      "updated": 1793901027881,
      "link": null,
      "locked": false,
      "text": "read_page_context reads the first chunk of\nthe requested page and its neighbours.\nOther chunk IDs are navigation only:\nthey must be read before they can be cited.\nThis is not full financial-table reconstruction.",
      "fontSize": 24,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "read_page_context reads the first chunk of\nthe requested page and its neighbours.\nOther chunk IDs are navigation only:\nthey must be read before they can be cited.\nThis is not full financial-table reconstruction.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
