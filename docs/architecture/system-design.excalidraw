      "seed": 1891483454,
      "version": 2,
      "versionNonce": 1259029182,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793901027881,
      "link": null,
      "locked": false,
      "text": "SSE = server-sent events over HTTP. Streamlit consumes the stream through ui_client.py; model inference stays local through Ollama.",
      "fontSize": 21,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SSE = server-sent events over HTTP. Streamlit consumes the stream through ui_client.py; model inference stays local through Ollama.",
      "autoResize": true,
      "lineHeight": 1.25
    },
