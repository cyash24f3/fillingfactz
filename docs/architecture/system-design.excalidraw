      "updated": 1793901027881,
      "link": null,
      "locked": false,
      "text": "documents.py / ingestion.py: manifest, PDF parse, fingerprints, index\nmemory.py: validate / recall / persist source evidence\nevaluate.py: 20 × 3 benchmark and accuracy / usage accounting\napi_evaluate.py: additional native HTTP / SSE checks\nmain.py / cli.py / workflow.py: command-line entry points\ntests/: contracts, faults, budgets, source checks and reviewer tests\n.github/workflows/tests.yml: installation + automated verification",
      "fontSize": 21,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "documents.py / ingestion.py: manifest, PDF parse, fingerprints, index\nmemory.py: validate / recall / persist source evidence\nevaluate.py: 20 × 3 benchmark and accuracy / usage accounting\napi_evaluate.py: additional native HTTP / SSE checks\nmain.py / cli.py / workflow.py: command-line entry points\ntests/: contracts, faults, budgets, source checks and reviewer tests\n.github/workflows/tests.yml: installation + automated verification",
      "autoResize": true,
      "lineHeight": 1.25
    },
