      "updated": 1793901027881,
      "link": null,
      "locked": false,
      "text": "Operational status is separate: complete = validated submission; incomplete = failure / budget stop. An incomplete NEI fallback is never scored as a correct completed answer.",
      "fontSize": 21,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Operational status is separate: complete = validated submission; incomplete = failure / budget stop. An incomplete NEI fallback is never scored as a correct completed answer.",
