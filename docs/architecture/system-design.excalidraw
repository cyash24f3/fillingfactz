      "isDeleted": false,
      "boundElements": null,
      "updated": 1793901027881,
      "link": null,
      "locked": false,
      "text": "Recalled passages seed model context.\nFresh retrieval still searches all filings.\nNewer disclosures can replace old facts.\nRepeated search hits return IDs rather\nthan duplicate passage text.",
      "fontSize": 22,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Recalled passages seed model context.\nFresh retrieval still searches all filings.\nNewer disclosures can replace old facts.\nRepeated search hits return IDs rather\nthan duplicate passage text.",
      "autoResize": true,
      "lineHeight": 1.25
    },
