      "link": null,
      "locked": false,
      "text": "Efficiency changes and measured tradeoff",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Efficiency changes and measured tradeoff",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "arch-0301",
      "type": "text",
      "x": 2655,
      "y": 4786,
      "width": 700.501708984375,
      "height": 137.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "arch-0299-group"
      ],
      "frameId": "frame-08",
      "index": "b3q",
      "roundness": null,
      "seed": 311758782,
      "version": 2,
      "versionNonce": 1376367422,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793901027881,
      "link": null,
      "locked": false,
      "text": "Filter weak recall; deduplicate passages; stop stagnant searches.\nFull vs original baseline: 85% → 100% accuracy;\n28.2% fewer tokens; 11.5% fewer LLM calls; 17.5% faster.\nMemory ON vs OFF: 4 fewer LLM calls and 4 fewer tool calls;\ntoken savings 0.9%. These are local, single-run measurements.",
      "fontSize": 22,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Filter weak recall; deduplicate passages; stop stagnant searches.\nFull vs original baseline: 85% → 100% accuracy;\n28.2% fewer tokens; 11.5% fewer LLM calls; 17.5% faster.\nMemory ON vs OFF: 4 fewer LLM calls and 4 fewer tool calls;\ntoken savings 0.9%. These are local, single-run measurements.",
      "autoResize": true,
      "lineHeight": 1.25
    },
