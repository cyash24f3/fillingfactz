      "boundElements": null,
      "updated": 1793901027881,
      "link": null,
      "locked": false,
      "text": "The model selects named tools; Python executes them.\nMalformed plan → fall back to original statement.\nBad arguments, missing passage or rejected quote → error feedback.\nOne format reminder; retries remain inside the same budgets.",
      "fontSize": 22,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The model selects named tools; Python executes them.\nMalformed plan → fall back to original statement.\nBad arguments, missing passage or rejected quote → error feedback.\nOne format reminder; retries remain inside the same budgets.",
      "autoResize": true,
      "lineHeight": 1.25
    },
