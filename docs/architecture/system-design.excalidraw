    {
      "id": "arch-0338",
      "type": "text",
      "x": 6385,
      "y": 4706,
      "width": 812.279541015625,
      "height": 183.75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "arch-0336-group"
      ],
      "frameId": "frame-09",
      "index": "b4R",
      "roundness": null,
      "seed": 226750114,
      "version": 2,
      "versionNonce": 2056856354,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793901027881,
      "link": null,
      "locked": false,
      "text": "MERMAID: Decomposer + Executor + Toolset + Memory retained.\nWeb retrieval → fixed official PDFs; MCP tools → Python registry.\nFull graph decomposition → one compact typed claim plan.\nLexical BM25 / FTS5; no embeddings or semantic reranking.\nNo OCR, durable graph checkpoint, or independent compound splitting.\nPage-neighbour reads help table continuity; not a full table engine.\nSource quotations establish provenance; final meaning remains model-dependent.",
      "fontSize": 21,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "MERMAID: Decomposer + Executor + Toolset + Memory retained.\nWeb retrieval → fixed official PDFs; MCP tools → Python registry.\nFull graph decomposition → one compact typed claim plan.\nLexical BM25 / FTS5; no embeddings or semantic reranking.\nNo OCR, durable graph checkpoint, or independent compound splitting.\nPage-neighbour reads help table continuity; not a full table engine.\nSource quotations establish provenance; final meaning remains model-dependent.",
      "autoResize": true,
      "lineHeight": 1.25
    },
