      "isDeleted": false,
      "boundElements": null,
      "updated": 1793901027881,
      "link": null,
      "locked": false,
      "text": "Code: documents.py → ingestion.py → retrieval.py / context_views.py → tools.py. Search is lexical; there is no embedding model or vector database.",
      "fontSize": 21,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Code: documents.py → ingestion.py → retrieval.py / context_views.py → tools.py. Search is lexical; there is no embedding model or vector database.",
