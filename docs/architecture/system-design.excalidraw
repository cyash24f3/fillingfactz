      "isDeleted": false,
      "boundElements": null,
      "updated": 1793901027881,
      "link": null,
      "locked": false,
      "text": "The application runs on one Mac. Python handles deterministic mechanics; the local LLM handles claim interpretation, tool choice and semantic judgment.",
