      "seed": 613738402,
      "version": 2,
      "versionNonce": 2141084706,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793901027881,
      "link": null,
      "locked": false,
      "text": "Default total across both agents: 8 model calls / 16 tool calls.\nFinal slot, or two searches with no new evidence: submit-only.\nValid candidate → complete. Exhaustion / model failure / repeated\nunstructured output → incomplete with an explicit stop_reason.",
      "fontSize": 22,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Default total across both agents: 8 model calls / 16 tool calls.\nFinal slot, or two searches with no new evidence: submit-only.\nValid candidate → complete. Exhaustion / model failure / repeated\nunstructured output → incomplete with an explicit stop_reason.",
      "autoResize": true,
      "lineHeight": 1.25
    },
